# Normalize line endings: LF in the repo, OS-native on checkout
* text=auto eol=lf

# Force LF for these types regardless of OS
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.env*  text eol=lf
*.sql   text eol=lf
*.prisma text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.jar   binary
